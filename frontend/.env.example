# Same-origin deployment model: the reverse proxy (or the Vite dev proxy) serves
# the SPA and forwards /api and /ws to the Gateway. No production domain is
# hardcoded anywhere in the frontend.
#
# Only override these when the frontend is NOT served from the same origin as
# the Gateway (not the supported deployment model, but useful for local probing).
# VITE_API_BASE_PATH=/api
# VITE_WS_BASE_PATH=/ws

# Target the Vite dev proxy forwards /api and /ws to.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Development only: answer every REST call from the in-memory mock
# (`src/shared/api/mock`). Ignored by production builds.
# VITE_MOCK_API=true
# Session the mock REST API starts with: logged-in | logged-out | in-room | session-expired
# VITE_MOCK_AUTH=logged-in

# Development only: replace the room and chat sockets with the in-memory mock
# (`src/shared/websocket/mock`). Ignored by production builds.
# VITE_MOCK_SOCKETS=true
# Scenario a mock room socket starts in when the room was not created over mock REST:
# empty | room-waiting | room-full | countdown | spymaster-turn | operative-turn |
# opponent-turn | game-over | assassin-loss
# VITE_MOCK_ROOM_SCENARIO=room-waiting
