PORT=8080
APP_ENV=development
# Optional overrides; empty values use APP_ENV defaults.
LOG_FORMAT=
LOG_LEVEL=
DATABASE_URL=postgres://auth:change-me-local-only@localhost:5432/auth?sslmode=disable

# Generate a random signing key: openssl rand -base64 32
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h
