PORT=8080
APP_ENV=development
# Optional overrides; empty values use APP_ENV defaults.
LOG_FORMAT=
LOG_LEVEL=
DATABASE_URL=postgres://auth:change-me-local-only@localhost:5432/auth?sslmode=disable

# Generate a random signing key: openssl rand -base64 32
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# Private listener for /internal/v1 routes; attach it only to the private network.
INTERNAL_PORT=8090
# Files holding each caller's service credential (32+ characters, one per
# caller). Leave a caller empty and every private call from it is refused.
# Create one with: openssl rand -hex 32 > <file>
WEB_BFF_CREDENTIAL_FILE=
WEB_BFF_PREVIOUS_CREDENTIAL_FILE=
GAME_GATEWAY_CREDENTIAL_FILE=
GAME_GATEWAY_PREVIOUS_CREDENTIAL_FILE=
CHAT_GATEWAY_CREDENTIAL_FILE=
CHAT_GATEWAY_PREVIOUS_CREDENTIAL_FILE=
USER_SERVICE_CREDENTIAL_FILE=
USER_SERVICE_PREVIOUS_CREDENTIAL_FILE=

# User Service private listener and Auth's credential for it. Required in
# production; without them new accounts get no User Service profile.
USER_INTERNAL_URL=
USER_SERVICE_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one provisioning request.
USER_INTERNAL_TIMEOUT=5s
