                                  "fill": "$Color / Text Faint",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Rooms, teams, roles and board state live in temporary storage while a match runs and are deleted once the room closes. Chat messages are delivered live and are not kept as history.",
