                                  "fontSize": "$Typography / Size / 2XL",
                                  "fontWeight": "800"
                                },
                                {
                                  "type": "text",
                                  "id": "D1DqZ",
                                  "name": "Section Body",
                                  "fill": "$Color / Text Faint",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Signing in sets two cookies that keep your session alive. They are HttpOnly, sent only to this site, and used for authentication alone. There are no advertising or analytics cookies.",
