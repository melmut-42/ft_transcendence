  "children": [
    {
      "type": "frame",
      "id": "SHQq2",
      "x": 1800,
      "y": -4677,
      "name": "HANDOFF — Developer Guide",
      "width": 1600,
      "fill": "$Color / Background",
      "layout": "vertical",
      "gap": 28,
      "padding": 48,
      "children": [
        {
          "type": "text",
          "id": "VFJpu",
          "name": "Title",
          "fill": "$Color / Text Ink",
          "content": "Developer Handoff Guide",
          "fontFamily": "Baloo 2",
          "fontSize": "$Typography / Size / 4XL",
          "fontWeight": "800"
        },
        {
          "type": "frame",
          "id": "FnBMW",
          "name": "Token naming Section",
          "width": "fill_container",
          "fill": "$Color / Surface",
          "cornerRadius": "$Radius / Large",
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "x4I8p2",
              "name": "Heading",
              "fill": "$Color / Text Ink",
              "content": "Token naming",
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / 2XL",
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "delIN",
              "name": "Body",
              "fill": "$Color / Text Ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Pen variables map to CSS custom properties by lower-casing and joining segments with hyphens: Color / Primary → --color-primary, Color / Shadow / Warm → --color-shadow-warm, Radius / 2XL → --radius-2xl, Stroke / Heavy → --stroke-heavy, Typography / Size / LG → --font-size-lg. Font family: Baloo 2. Icons: Material Symbols Rounded, weight 700.",
              "lineHeight": 1.35,
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / LG",
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ogVBc",
          "name": "Which component to use Section",
          "width": "fill_container",
          "fill": "$Color / Surface",
          "cornerRadius": "$Radius / Large",
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "fH4NW",
              "name": "Heading",
              "fill": "$Color / Text Ink",
              "content": "Which component to use",
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / 2XL",
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "QXAlS",
              "name": "Body",
              "fill": "$Color / Text Ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Primary action → Button / Primary / Default (Ready, Pressing, Disabled states)\nSecondary action → Button / Secondary / Filled, Outline Coral (cancel), Outline Blue, Muted (Pass), Icon (Invite)\nDestructive → Button / Destructive / Default; low-emphasis leave → Button / Leave Room\nClose / back / settings → Button / Icon / Close, Button / Icon / Navigation\nText fields → Input / Text / * states, Input / Leading Icon, Input / Password, Input / Numeric, Input / Room Code\nField error → Feedback / Field Message / Error; page-level result → Feedback / Alert / *\nConfirmation → Feedback / Modal / Confirmation (safe action left, committing action right)\nLoading → Feedback / Loading / Dots, Feedback / Skeleton / Player Card\nBoard → Game / Word Card (hidden), Selected, Team A, Team B, Neutral, Danger, Disabled\nLobby → Game / Room Code, Card / Team Player Row (+ / Empty), Card / Role Option, Game / Team Panel, Game / Badge / Status, Game / Badge / Player Role\nApp chrome → Navigation / Profile Menu, Navigation / Game Profile Header, Navigation / Chat Launcher, Button / Chat / Unread, Navigation / Mobile Bar",
              "lineHeight": 1.35,
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / LG",
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "FdkyD",
          "name": "Breakpoints Section",
          "width": "fill_container",
          "fill": "$Color / Surface",
          "cornerRadius": "$Radius / Large",
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "NKNYY",
              "name": "Heading",
              "fill": "$Color / Text Ink",
              "content": "Breakpoints",
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / 2XL",
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "sgKuI",
              "name": "Body",
              "fill": "$Color / Text Ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Desktop 1920×1080 (all screens), tablet 834×1194 and mobile 390×844 (every page: the Responsive Layouts row inside each PAGE frame). The 5×5 board keeps five columns at every size.",
              "lineHeight": 1.35,
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / LG",
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "X0INf",
          "name": "Open decisions Section",
          "width": "fill_container",
          "fill": "$Color / Surface",
          "cornerRadius": "$Radius / Large",
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "e8i8h",
              "name": "Heading",
              "fill": "$Color / Text Ink",
              "content": "Open decisions",
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / 2XL",
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "FUJxN",
              "name": "Body",
              "fill": "$Color / Text Ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "1. Timed mode: no timer in the designed mode; Game / Timer is ready if a timed mode is added.\n2. Score bar meaning (cards found or cards remaining) must match the game-state contract.\n3. Room discovery is code-based; there is no public room list.",
              "lineHeight": 1.35,
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / LG",
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "rsK8e",
          "name": "Assets Section",
          "width": "fill_container",
          "fill": "$Color / Surface",
          "cornerRadius": "$Radius / Large",
          "layout": "vertical",
          "gap": 8,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "I3NlnY",
              "name": "Heading",
              "fill": "$Color / Text Ink",
              "content": "Assets",
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / 2XL",
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "l8Merp",
              "name": "Body",
              "fill": "$Color / Text Ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Avatars: ui-design/svg/avatars/*.svg (vector) and ui-design/img/avatars/*.png (raster). The landing hero is ui-design/img/illustrations/landing-hero.png. Other illustrations are embedded vector artwork in ui.pen and export as SVG or PNG from their frames.",
              "lineHeight": 1.35,
              "fontFamily": "Baloo 2",
              "fontSize": "$Typography / Size / LG",
              "fontWeight": "600"
            }
          ]
        }
      ]
    },
