                                {
                                  "type": "text",
                                  "id": "Jgf0E",
                                  "name": "Section Heading",
                                  "fill": "$Color / Text Ink",
                                  "content": "What we store",
                                  "lineHeight": 1,
                                  "fontFamily": "Baloo 2",
                                  "fontSize": "$Typography / Size / 2XL",
                                  "fontWeight": "800"
                                },
                                {
                                  "type": "text",
                                  "id": "awRym",
                                  "name": "Section Body",
                                  "fill": "$Color / Text Faint",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Your account holds an email address, a username, a password stored as a hash, and the avatar you pick. Playing a match adds your results: wins, losses and the level derived from them.",
                                  "lineHeight": 1.35,
                                  "fontFamily": "Baloo 2",
                                  "fontSize": "$Typography / Size / LG",
                                  "fontWeight": "600"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "qgqpc",
                              "name": "Why we store it",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 7,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "WEQUT",
                                  "name": "Section Heading",
                                  "fill": "$Color / Text Ink",
                                  "content": "Why we store it",
                                  "lineHeight": 1,
                                  "fontFamily": "Baloo 2",
                                  "fontSize": "$Typography / Size / 2XL",
                                  "fontWeight": "800"
                                },
                                {
                                  "type": "text",
                                  "id": "qmobo",
                                  "name": "Section Body",
                                  "fill": "$Color / Text Faint",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Account data signs you in and identifies you to other players. Match results power your profile, your statistics and the friends list. Nothing is sold or shared with advertisers.",
                                  "lineHeight": 1.35,
                                  "fontFamily": "Baloo 2",
                                  "fontSize": "$Typography / Size / LG",
                                  "fontWeight": "600"
                                }
                              ]
